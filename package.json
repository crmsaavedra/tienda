{
  "name": "autopartes-pro",
  "version": "1.0.0",
  "description": "E-commerce de repuestos automotrices",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:catalog": "node src/seed-catalog.js",
    "seed:demo": "node src/seed-demo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "check": "node --check src/server.js && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
